# Drizzle
DATABASE_URL="postgres://internery:internery@localhost:5432/internery"

# Development seed (pnpm db:seed). Defaults to Password123! when unset.
# SEED_PASSWORD="Password123!"

ORIGIN="http://localhost:5173"

# Docker demo (docker-compose.yaml, profile "demo"). Leave unset for the
# defaults below; change APP_ORIGIN when the demo is opened at another address
# and rebuild the image.
# APP_PORT="3000"
# APP_ORIGIN="http://localhost:3000"

# MinIO / S3 (docker compose)
# The minio-init service creates this bucket on first start.
MINIO_ROOT_USER="admin"
MINIO_ROOT_PASSWORD="change-me-please"
MINIO_BROWSER_REDIRECT_URL="http://localhost:9001"
S3_BUCKET="internery-staging"

# Storage client. Local development reuses the MinIO root pair; a real
# deployment uses a user scoped to one bucket, never the account root.
# https://min.io/docs/minio/linux/reference/minio-mc-admin/mc-admin-user.html
# Generate that user's secret with one of the commands below.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="admin"
S3_SECRET_ACCESS_KEY="change-me-please"

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
# Generate one:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""
# GitHub OAuth
# https://www.better-auth.com/docs/authentication/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Resend transactional email
# The sender domain must be verified in Resend.
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS="Internery <no-reply@example.com>"

# Work-record signatures (HMAC-SHA256).
# Rotating this value invalidates every existing work-record signature.
# Generate one:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
#   openssl rand -base64 32
WORK_RECORD_SECRET="change-me-please"

{
	"name": "internery",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:db": "node --env-file=.env.test node_modules/vitest/vitest.mjs run",
		"test:watch": "vitest",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:start": "docker compose up",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "node --env-file=.env scripts/seed.ts",
		"email:test": "node --env-file=.env scripts/send-test-email.ts",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes && node scripts/normalize-auth-schema.mjs && prettier --write src/lib/server/db/auth.schema.ts",
		"storage:sweep": "node --env-file=.env scripts/storage-sweep.ts",
		"retention:run": "node --env-file=.env scripts/retention.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1161.0",
		"@fontsource/be-vietnam-pro": "^5.3.0",
		"@node-rs/argon2": "^2.2.2",
		"cn": "^0.5.2",
		"file-type": "^22.3.0",
		"fuse.js": "^7.5.0",
		"gsap": "^3.15.0",
		"resend": "^6.34.1",
		"sharp": "^0.35.5",
		"svelte-easy-crop": "^5.0.1",
		"svelte-sonner": "^1.2.3",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"auth": "^1.6.24",
		"better-auth": "^1.6.24",
		"bits-ui": "^2.20.3",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"postgres": "^3.4.9",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"remixicon-svelte": "^0.0.5",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}

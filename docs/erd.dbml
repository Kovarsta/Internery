// Internery database schema
//
// Source of truth: src/lib/server/db/auth.schema.ts (Better Auth, generated) and
// src/lib/server/db/product.schema.ts (application tables). 21 tables in total:
// 4 identity tables and 17 product tables.
//
// Naming is intentionally mixed: Better Auth declares snake_case columns and the
// product tables use camelCase. See docs/decisions/camel-case-columns.md.
//
// Open this file at https://dbdiagram.io, or use a DBML extension in the editor.

/* ------------------------------------------------------------------ */
/* Enums                                                               */
/* ------------------------------------------------------------------ */

Enum user_role {
  STUDENT
  EMPLOYER
  ADMIN
}

Enum account_status {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  LOCKED
  DELETED
}

Enum org_type {
  COMPANY
  INDIVIDUAL
}

Enum employer_verification {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

Enum salary_type {
  HOURLY
  DAILY
  FIXED
}

Enum job_status {
  HIRING
  FILLED
  COMPLETED
  CANCELLED
}

Enum day_of_week {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

Enum application_status {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

Enum verification_request_status {
  PENDING
  APPROVED
  REJECTED
}

Enum report_status {
  OPEN
  RESOLVED
}

Enum ai_verdict {
  FIT
  MAYBE_FIT
}

Enum notification_type {
  APPLICATION_RECEIVED
  APPLICATION_WITHDRAWN
  APPLICATION_ACCEPTED
  APPLICATION_REJECTED
  JOB_FILLED
  JOB_COMPLETED
  JOB_CANCELLED
  JOB_HIDDEN
  JOB_AUTO_HIDDEN
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  REVIEW_RECEIVED
  WORK_RECORD_CREATED
}

/* ------------------------------------------------------------------ */
/* Identity (Better Auth)                                              */
/* ------------------------------------------------------------------ */

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  name text [not null]
  email text [not null, unique]
  email_verified boolean [not null, default: false]
  image text [note: 'OAuth provider image, used as the avatar fallback.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  role user_role [not null, default: 'STUDENT']
  status account_status [not null, default: 'PENDING_VERIFICATION']

  Note: 'One row per account. Role and status are server-owned.'
}

Table sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  expires_at timestamptz [not null]
  token text [not null, unique]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  ip_address text
  user_agent text
  user_id uuid [not null]

  indexes {
    user_id [name: 'sessions_userId_idx']
  }
}

Table accounts {
  id uuid [pk, default: `gen_random_uuid()`]
  account_id text [not null]
  provider_id text [not null]
  user_id uuid [not null]
  access_token text
  refresh_token text
  id_token text
  access_token_expires_at timestamptz
  refresh_token_expires_at timestamptz
  scope text
  password text [note: 'Argon2id hash for the credential provider.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    user_id [name: 'accounts_userId_idx']
  }
}

Table verifications {
  id uuid [pk, default: `gen_random_uuid()`]
  identifier text [not null]
  value text [not null]
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    identifier [name: 'verifications_identifier_idx']
  }
}

/* ------------------------------------------------------------------ */
/* Profiles and moderation                                             */
/* ------------------------------------------------------------------ */

Table user_profiles {
  user_id uuid [pk]
  phone varchar(20)
  avatar_key text [note: 'Private storage key; null means no uploaded avatar.']
  onboarded_at timestamptz [note: 'Null until an OAuth account chooses a role.']
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Created with the Better Auth user, so reads can rely on the row.'
}

Table user_moderation {
  user_id uuid [pk]
  failed_login_count integer [not null, default: 0]
  locked_until timestamptz [note: 'Temporary login lockout.']
  locked_at timestamptz [note: 'Admin lock; separate from locked_until.']
  locked_by uuid
  lock_reason varchar(500)
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Created lazily on the first moderation event. A missing row means no lock.'
}

Table student_profiles {
  user_id uuid [pk]
  university varchar(160)
  major varchar(160)
  skills text[] [not null, default: `ARRAY[]::text[]`]
  availability text
  bio text
  cv_key text [note: 'CV columns are all set or all null.']
  cv_file_name varchar(255)
  cv_mime_type varchar(100)
  cv_size_bytes integer [note: '1 to 5 MB when present.']
  rating_avg numeric(3,2) [not null, default: 0]
  rating_count integer [not null, default: 0]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Rating columns are a denormalised summary of visible reviews.'
}

Table employer_profiles {
  user_id uuid [pk]
  org_name varchar(200) [not null]
  org_type org_type [not null, default: 'INDIVIDUAL']
  description text
  address varchar(300)
  contact_phone varchar(20)
  verification_status employer_verification [not null, default: 'UNVERIFIED']
  verified_at timestamptz
  rating_avg numeric(3,2) [not null, default: 0]
  rating_count integer [not null, default: 0]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'VERIFIED means an admin checked the organisation; it is not a legal guarantee.'
}

/* ------------------------------------------------------------------ */
/* Marketplace                                                         */
/* ------------------------------------------------------------------ */

Table categories {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(100) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Names are unique case-insensitively via a lower(name) index. In-use categories are deactivated, never deleted.'
}

Table locations {
  id uuid [pk, default: `gen_random_uuid()`]
  country_code varchar(2) [not null]
  country_name varchar(80) [not null]
  name varchar(160) [not null]
  display_name varchar(220) [not null]
  slug varchar(200) [not null]
  admin_area varchar(160)
  aliases text[] [not null, default: `ARRAY[]::text[]`]
  search_text text [not null]
  is_remote boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (country_code, slug) [unique]
    search_text [type: gin, note: 'pg_trgm']
  }

  Note: 'Canonical city/province rows. Jobs reference this table by location_id.'
}

Table jobs {
  id uuid [pk, default: `gen_random_uuid()`]
  employer_id uuid [not null]
  category_id uuid [not null]
  title varchar(200) [not null]
  description text [not null]
  location_id uuid [not null]
  days_of_week day_of_week[] [not null]
  start_time time [not null]
  end_time time [not null]
  schedule_note text
  salary_amount integer [not null, note: 'VND, greater than 0.']
  salary_type salary_type [not null]
  start_date date [not null]
  end_date date [not null, note: 'Must be after start_date.']
  positions_needed integer [not null, default: 1]
  status job_status [not null, default: 'HIRING']
  is_hidden boolean [not null, default: false]
  hidden_reason varchar(500)
  hidden_by uuid [note: 'Null when the report threshold hid the job automatically.']
  hidden_at timestamptz
  needs_review boolean [not null, default: false, note: 'Set by the scam keyword scan.']
  flagged_terms text[] [not null, default: `ARRAY[]::text[]`]
  completed_at timestamptz
  cancelled_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Status is HIRING, FILLED, COMPLETED or CANCELLED; terminal states are final. Hidden jobs are excluded from search.'
}

Table applications {
  id uuid [pk, default: `gen_random_uuid()`]
  job_id uuid [not null]
  student_id uuid [not null]
  message varchar(1000)
  cv_key text [note: 'Snapshot of the profile CV at apply time.']
  cv_file_name varchar(255)
  status application_status [not null, default: 'PENDING']
  reject_reason varchar(500)
  decided_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (job_id, student_id) [unique, name: 'applications_job_student_uq']
  }

  Note: 'One application per student per job. A withdrawn row is revived on re-apply, so the uniqueness is unconditional.'
}

Table saved_jobs {
  user_id uuid [not null]
  job_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, job_id) [pk]
  }
}

/* ------------------------------------------------------------------ */
/* Reviews, notifications and work records                             */
/* ------------------------------------------------------------------ */

Table reviews {
  id uuid [pk, default: `gen_random_uuid()`]
  job_id uuid [not null]
  reviewer_id uuid [not null]
  reviewee_id uuid [not null]
  rating smallint [not null, note: '1 to 5.']
  comment varchar(500)
  is_hidden boolean [not null, default: false]
  hidden_by uuid
  hidden_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (job_id, reviewer_id, reviewee_id) [unique, name: 'reviews_job_reviewer_reviewee_uq']
  }

  Note: 'Only for COMPLETED jobs; reviewer and reviewee are the employer and an accepted student.'
}

Table notifications {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  type notification_type [not null]
  title varchar(200) [not null]
  body text
  job_id uuid [note: 'Deep-link target when the notification is about a job.']
  application_id uuid
  read_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, created_at) [name: 'notifications_user_idx']
  }
}

Table verification_requests {
  id uuid [pk, default: `gen_random_uuid()`]
  employer_id uuid [not null]
  org_name varchar(200) [not null]
  website_url varchar(500)
  contact_info varchar(300) [not null]
  license_key text
  status verification_request_status [not null, default: 'PENDING']
  reject_reason varchar(500)
  reviewed_by uuid
  reviewed_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  Note: 'One PENDING request per employer, enforced by a partial unique index.'
}

Table reports {
  id uuid [pk, default: `gen_random_uuid()`]
  job_id uuid [not null]
  reporter_id uuid [not null]
  reason varchar(500) [not null]
  status report_status [not null, default: 'OPEN']
  resolved_by uuid
  resolved_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (job_id, reporter_id) [unique, name: 'reports_job_reporter_uq']
  }

  Note: 'One report per student per job. Three distinct open reporters hide the job automatically.'
}

Table work_records {
  id uuid [pk, default: `gen_random_uuid()`]
  job_id uuid [not null]
  student_id uuid [not null]
  employer_id uuid [not null]
  review_id uuid [not null]
  payload jsonb [not null, note: 'Signed snapshot of names, job dates, rating and comment.']
  signature text [not null, note: 'HMAC-SHA256 over canonical JSON.']
  signature_version smallint [not null, default: 1]
  is_public boolean [not null, default: false]
  published_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (job_id, student_id) [unique, name: 'work_records_job_student_uq']
  }

  Note: 'Issued in the same transaction as the employer review of the student. Public records require published_at.'
}

/* ------------------------------------------------------------------ */
/* AI and audit                                                        */
/* ------------------------------------------------------------------ */

Table ai_consents {
  student_id uuid [pk]
  consented_at timestamptz [not null, default: `now()`]
  withdrawn_at timestamptz [note: 'Null means consent is active.']
}

Table ai_explanations {
  id uuid [pk, default: `gen_random_uuid()`]
  student_id uuid [not null]
  job_id uuid [not null]
  cv_hash varchar(64) [not null]
  verdict ai_verdict [not null]
  reasons jsonb [not null, note: 'Only reasons whose cvQuote was found in the CV.']
  gaps text[] [not null, default: `ARRAY[]::text[]`]
  model varchar(100) [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (student_id, job_id, cv_hash) [unique, name: 'ai_explanations_uq']
  }

  Note: 'Read-through cache; deleted when the student withdraws consent.'
}

Table ai_usage {
  user_id uuid [not null]
  day date [not null]
  count integer [not null, default: 0]

  indexes {
    (user_id, day) [pk]
  }

  Note: 'Daily AI call counter; the limit is enforced by an upsert-increment.'
}

Table audit_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  actor_id uuid [note: 'Null means the system performed the action.']
  action varchar(60) [not null]
  target_type varchar(40) [not null]
  target_id uuid [not null, note: 'Polymorphic target; no foreign key by design.']
  metadata jsonb
  created_at timestamptz [not null, default: `now()`]

  Note: 'Append-only trail for admin locks, job hides, review removal and verification decisions.'
}

/* ------------------------------------------------------------------ */
/* Relationships                                                       */
/* ------------------------------------------------------------------ */

// Identity

Ref: sessions.user_id > users.id [delete: cascade]
Ref: accounts.user_id > users.id [delete: cascade]

// Profiles and moderation

Ref: user_profiles.user_id - users.id [delete: cascade]
Ref: user_moderation.user_id - users.id [delete: cascade]
Ref: user_moderation.locked_by > users.id [delete: set null]
Ref: student_profiles.user_id - users.id [delete: cascade]
Ref: employer_profiles.user_id - users.id [delete: cascade]

// Jobs

Ref: jobs.employer_id > users.id [delete: restrict]
Ref: jobs.category_id > categories.id [delete: restrict]
Ref: jobs.location_id > locations.id [delete: restrict]
Ref: jobs.hidden_by > users.id [delete: set null]

// Applications and saved jobs

Ref: applications.job_id > jobs.id [delete: cascade]
Ref: applications.student_id > users.id [delete: restrict]
Ref: saved_jobs.user_id > users.id [delete: cascade]
Ref: saved_jobs.job_id > jobs.id [delete: cascade]

// Reviews and work records

Ref: reviews.job_id > jobs.id [delete: restrict]
Ref: reviews.reviewer_id > users.id [delete: restrict]
Ref: reviews.reviewee_id > users.id [delete: restrict]
Ref: reviews.hidden_by > users.id [delete: set null]
Ref: work_records.job_id > jobs.id [delete: restrict]
Ref: work_records.student_id > users.id [delete: restrict]
Ref: work_records.employer_id > users.id [delete: restrict]
Ref: work_records.review_id > reviews.id [delete: restrict]

// Notifications

Ref: notifications.user_id > users.id [delete: cascade]
Ref: notifications.job_id > jobs.id [delete: set null]
Ref: notifications.application_id > applications.id [delete: set null]

// Trust

Ref: verification_requests.employer_id > users.id [delete: cascade]
Ref: verification_requests.reviewed_by > users.id [delete: set null]
Ref: reports.job_id > jobs.id [delete: cascade]
Ref: reports.reporter_id > users.id [delete: cascade]
Ref: reports.resolved_by > users.id [delete: set null]

// AI and audit

Ref: ai_consents.student_id - users.id [delete: cascade]
Ref: ai_explanations.student_id > users.id [delete: cascade]
Ref: ai_explanations.job_id > jobs.id [delete: cascade]
Ref: ai_usage.user_id > users.id [delete: cascade]
Ref: audit_logs.actor_id > users.id [delete: set null]
